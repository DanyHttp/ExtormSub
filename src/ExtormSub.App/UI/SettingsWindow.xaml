<Window x:Class="ExtormSub.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExtormSub.App.UI"
        Title="ExtormSub Settings" Width="980" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource F.Ui}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource B.Sidebar}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <Image Source="pack://application:,,,/Assets/Mark.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ExtormSub" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Live AI subtitles" FontSize="11.5" Foreground="{StaticResource B.TextSubtle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#1A1A1E" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            </StackPanel>
                            <TextBlock Text="Ctrl+Alt+S to start or stop" FontSize="11.5" Foreground="{StaticResource B.TextSubtle}" Margin="16,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleListening}" Content="{Binding ListenLabel}" Padding="14,9" />
                </StackPanel>

                <ListBox x:Name="Nav" Style="{StaticResource NavList}" ItemsSource="{Binding Source={x:Static local:SettingsViewModel.Pages}}"
                         SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>
        </Border>

        <!-- Page -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,30,40,40" MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock x:Name="PageTitle" Style="{StaticResource T.PageTitle}" />
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource T.PageSubtitle}" />
                <ContentControl x:Name="PageHost" Margin="0,6,0,0" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
