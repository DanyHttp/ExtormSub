<UserControl x:Class="ExtormSub.App.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ExtormSub.App.UI">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/Logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ExtormSub" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource B.TextMuted}" Margin="0,2,0,0">
                        <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,8,0,0" MaxWidth="480"
                               Text="Real-time subtitles for anything your PC plays. Speech is recognised locally with whisper.cpp; only finished English lines are sent to the translation provider you choose. Update checks download only a small version file." />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="UPDATES" Style="{StaticResource T.Section}" />
        <Border Style="{StaticResource Card}">
            <StackPanel Margin="0,0,0,-1">
                <ui:SettingRow Header="Check for updates automatically" Description="Look for a new version when ExtormSub starts and once a day. Nothing is installed without your click.">
                    <CheckBox IsChecked="{Binding S.General.CheckForUpdates}" />
                </ui:SettingRow>
                <ui:SettingRow Header="ExtormSub updates" Description="{Binding Updates.Status}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check now" Command="{Binding Updates.Check}"
                                Visibility="{Binding Updates.IsAvailable, Converter={StaticResource Collapsed}}" />
                        <Button Content="Install" Style="{StaticResource Button.Primary}" Command="{Binding Updates.Install}"
                                Visibility="{Binding Updates.IsAvailable, Converter={StaticResource Visible}}" />
                        <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding Updates.Cancel}"
                                Visibility="{Binding Updates.IsDownloading, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ui:SettingRow>
                <Border Padding="18,0,18,12" Visibility="{Binding Updates.IsDownloading, Converter={StaticResource Visible}}">
                    <ProgressBar Value="{Binding Updates.Progress, Mode=OneWay}" Maximum="100" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="OPEN SOURCE" Style="{StaticResource T.Section}" />
        <Border Style="{StaticResource Card}">
            <StackPanel Margin="0,0,0,-1">
                <ui:SettingRow Header="whisper.cpp · Whisper.net" Description="Local speech recognition — MIT" />
                <ui:SettingRow Header="Silero VAD" Description="Voice activity detection model — MIT" />
                <ui:SettingRow Header="ONNX Runtime" Description="Runs the voice detector — MIT" />
                <ui:SettingRow Header="NAudio" Description="WASAPI loopback capture and resampling — MIT" />
                <ui:SettingRow Header="Microsoft.Data.Sqlite · SQLite" Description="Transcript history — MIT · public domain" />
                <ui:SettingRow Header="Serilog" Description="Structured logging — Apache 2.0" />
                <ui:SettingRow Header="Microsoft.Extensions.*" Description="Hosting, dependency injection, logging — MIT" />
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource T.Caption}" Margin="4,10,0,0"
                   Text="Design informed by Handy, ARIA, LiveCaptioner, VoxScribe, realtime-captions-system-audio and universal-translator. No code from GPL projects is included." />
    </StackPanel>
</UserControl>
