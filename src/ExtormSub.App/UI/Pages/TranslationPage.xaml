<UserControl x:Class="ExtormSub.App.UI.Pages.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ExtormSub.App.UI">
    <StackPanel>
        <TextBlock Text="PROVIDER" Style="{StaticResource T.Section}" />
        <Border Style="{StaticResource Card}">
            <StackPanel Margin="0,0,0,-1">
                <ui:SettingRow Header="Translate subtitles" Description="Stays off until you add an API key, or pick LibreTranslate to run it free on this PC. Without one, or when the API is unreachable, English subtitles keep working.">
                    <CheckBox IsChecked="{Binding S.Translation.Enabled}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Provider" Description="Any OpenAI-compatible endpoint. Choosing a provider fills in its endpoint and a sensible model.">
                    <ComboBox Width="240" ItemsSource="{x:Static ui:SettingsViewModel.ProviderNames}" SelectedItem="{Binding Provider}" />
                </ui:SettingRow>
                <StackPanel Visibility="{Binding IsLibreTranslate, Converter={StaticResource Visible}}">
                    <ui:SettingRow Header="LibreTranslate on this PC" Description="{Binding LibreStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install" Style="{StaticResource Button.Primary}" Command="{Binding InstallLibre}"
                                    Visibility="{Binding LibreInstalled, Converter={StaticResource Collapsed}}" />
                            <Button Content="Reinstall" Command="{Binding InstallLibre}"
                                    Visibility="{Binding LibreInstalled, Converter={StaticResource Visible}}" />
                            <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelLibre}"
                                    Visibility="{Binding IsInstallingLibre, Converter={StaticResource Visible}}" />
                            <Button Content="Remove" Margin="8,0,0,0" Style="{StaticResource Button.Danger}" Command="{Binding RemoveLibre}"
                                    Visibility="{Binding LibreInstalled, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </ui:SettingRow>
                    <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="18,12">
                        <TextBlock Text="{Binding LibreLog}" Style="{StaticResource T.Value}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource B.TextMuted}" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LibreLog}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <ui:SettingRow Header="Endpoint" Description="Base URL of the translation server.">
                    <TextBox Width="320" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Model" Visibility="{Binding IsLibreTranslate, Converter={StaticResource Collapsed}}">
                    <TextBox Width="240" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingRow>
                <ui:SettingRow Header="API key" Description="{Binding ApiKeyHint}">
                    <PasswordBox x:Name="KeyBox" Width="240" PasswordChanged="KeyBox_PasswordChanged" />
                </ui:SettingRow>
                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="18,13">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Test connection" Command="{Binding TestTranslation}" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestOk}" Value="True">
                                            <Setter Property="Foreground" Value="#86EFAC" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TestOk}" Value="False">
                                            <Setter Property="Foreground" Value="#FCA5A5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="LANGUAGE" Style="{StaticResource T.Section}" />
        <Border Style="{StaticResource Card}">
            <StackPanel Margin="0,0,0,-1">
                <ui:SettingRow Header="Translate into">
                    <TextBox Width="200" Text="{Binding S.Translation.TargetLanguage, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Spoken language">
                    <TextBox Width="200" Text="{Binding S.Translation.SourceLanguage, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Conversation context" Description="Previous subtitles sent with each request so pronouns, tone and slang translate correctly.">
                    <ui:ValueSlider Minimum="0" Maximum="10" TickFrequency="1" Value="{Binding S.Translation.ContextSize}" Format="{}{0:0} lines" />
                </ui:SettingRow>
                <ui:SettingRow Header="Show English when translation is unavailable" Description="Falls back to the original text instead of showing nothing.">
                    <CheckBox IsChecked="{Binding S.Translation.ShowOriginalWhenUnavailable}" />
                </ui:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="COST &amp; RELIABILITY" Style="{StaticResource T.Section}" />
        <Border Style="{StaticResource Card}">
            <StackPanel Margin="0,0,0,-1">
                <ui:SettingRow Header="Temperature" Description="Lower is more literal and consistent.">
                    <ui:ValueSlider Minimum="0" Maximum="1.5" TickFrequency="0.05" Value="{Binding S.Translation.Temperature}" Format="{}{0:0.00}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Timeout">
                    <ui:ValueSlider Minimum="2" Maximum="60" TickFrequency="1" Value="{Binding S.Translation.TimeoutSeconds}" Format="{}{0:0} s" />
                </ui:SettingRow>
                <ui:SettingRow Header="Retries" Description="With exponential backoff. Invalid keys are never retried.">
                    <ui:ValueSlider Minimum="0" Maximum="6" TickFrequency="1" Value="{Binding S.Translation.MaxRetries}" Format="{}{0:0}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Parallel requests">
                    <ui:ValueSlider Minimum="1" Maximum="6" TickFrequency="1" Value="{Binding S.Translation.MaxConcurrentRequests}" Format="{}{0:0}" />
                </ui:SettingRow>
                <ui:SettingRow Header="Rate limit" Description="Maximum requests per minute. 0 = unlimited. Identical lines are served from cache.">
                    <ui:ValueSlider Minimum="0" Maximum="300" TickFrequency="10" Value="{Binding S.Translation.MaxRequestsPerMinute}" Format="{}{0:0}/min" />
                </ui:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="GLOSSARY" Style="{StaticResource T.Section}" />
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <TextBlock Style="{StaticResource T.Caption}" Margin="0,0,0,10"
                           Text="One term per line: Term; misheard variants; fixed translation. Terms fix speech-recognition spelling and are passed to the translator. Example: ChatGPT; chat gpt, chat g p t" />
                <TextBox Style="{StaticResource TextBox.Multiline}" Height="160" Padding="10,8"
                         Text="{Binding GlossaryText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
